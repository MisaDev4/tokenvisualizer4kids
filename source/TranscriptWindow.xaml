<Window x:Class="TokenTracker.TranscriptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcript"
        Width="1080"
        Height="820"
        MinWidth="620"
        MinHeight="400"
        Background="{StaticResource PageBrush}"
        Foreground="{StaticResource Ink2Brush}"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Window.Resources>
    <!-- Selectable body text. The wheel is forwarded so a long row never traps
         the scroll of the list it sits in. -->
    <Style x:Key="BodyText" TargetType="TextBox">
      <Setter Property="IsReadOnly" Value="True" />
      <Setter Property="IsTabStop" Value="False" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,6,0,0" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="SelectionBrush" Value="{StaticResource AccentBrush}" />
      <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
      <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
      <EventSetter Event="PreviewMouseWheel" Handler="BodyText_PreviewMouseWheel" />
    </Style>

    <Style x:Key="RowContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <ContentPresenter />
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="18,14,18,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ═══ What you double-clicked ═══ -->
    <Grid Grid.Row="0" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource InkBrush}" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="SubtitleText" FontSize="12" Foreground="{StaticResource MutedBrush}"
                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="PathText" FontSize="11" Foreground="{StaticResource MutedBrush}"
                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Button x:Name="JumpButton" Content="This response" Style="{StaticResource AccentButton}"
                Padding="10,5" FontSize="12" Margin="6,3,0,3" Click="Jump_Click"
                ToolTip="Scroll back to the response whose block you double-clicked." />
        <Button Content="Copy all" Padding="10,5" FontSize="12" Margin="6,3,0,3" Click="CopyAll_Click"
                ToolTip="Copy the whole transcript, as shown here, to the clipboard." />
        <Button Content="Show file" Padding="10,5" FontSize="12" Margin="6,3,0,3" Click="ShowFile_Click"
                ToolTip="Open the folder holding this .jsonl log, with the file selected." />
      </WrapPanel>
    </Grid>

    <!-- ═══ Filter ═══ -->
    <Grid Grid.Row="1" Margin="0,0,0,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" Grid.Column="0" Padding="8,6" FontSize="12"
               Foreground="{StaticResource InkBrush}" Background="{StaticResource RaisedBrush}"
               BorderBrush="{StaticResource GridlineBrush}" BorderThickness="1"
               CaretBrush="{StaticResource InkBrush}" TextChanged="SearchBox_TextChanged" />
      <TextBlock x:Name="SearchHint" Grid.Column="0" Margin="10,0,0,0" FontSize="12" IsHitTestVisible="False"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                 Text="Filter this transcript — a file name, a phrase, a tool" />
      <TextBlock x:Name="CountText" Grid.Column="1" Margin="12,0,0,0" FontSize="12"
                 Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
    </Grid>

    <!-- ═══ The conversation ═══ -->
    <Grid Grid.Row="2">
      <ListBox x:Name="EntryList" Background="Transparent" BorderThickness="0"
               ItemContainerStyle="{StaticResource RowContainer}"
               HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               VirtualizingPanel.IsVirtualizing="True"
               VirtualizingPanel.VirtualizationMode="Recycling"
               VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <Border Background="{Binding Fill}" BorderBrush="{Binding Outline}" BorderThickness="1"
                    CornerRadius="10" Padding="12,9" Margin="0,0,4,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding Rail}" CornerRadius="2" Margin="0,1,11,1" />
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                               Foreground="{Binding Rail}" />
                    <TextBlock Text="{Binding Detail}" FontSize="12" Margin="9,0,0,0" MaxWidth="620"
                               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding DetailVisibility}" />
                    <TextBlock Text="{Binding Time}" FontSize="11" Margin="9,0,0,0"
                               Foreground="{StaticResource BaselineBrush}" />
                  </StackPanel>
                  <TextBox Text="{Binding Body, Mode=OneWay}" Style="{StaticResource BodyText}"
                           Foreground="{Binding Ink}" FontFamily="{Binding Font}"
                           Visibility="{Binding BodyVisibility}" />
                  <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,5,0,0"
                             Foreground="{StaticResource AccentBrush}" Cursor="Hand"
                             TextDecorations="Underline" HorizontalAlignment="Left"
                             MouseLeftButtonUp="Note_Click"
                             Visibility="{Binding NoteVisibility}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      <!-- Privacy curtain: the transcript is exactly the text that setting hides -->
      <Border x:Name="PrivacyCurtain" Style="{StaticResource Card}" Padding="24"
              HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"
              Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Hidden while “Hide personal data” is on" FontSize="14" FontWeight="SemiBold"
                     Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" />
          <TextBlock Text="This is the conversation itself — prompts, replies, file contents. It stays covered until you say otherwise."
                     FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                     Margin="0,8,0,0" />
          <Button Content="Show it anyway" Style="{StaticResource AccentButton}" Padding="12,6"
                  HorizontalAlignment="Left" Margin="0,14,0,0" Click="Reveal_Click" />
        </StackPanel>
      </Border>

      <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontSize="13" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                 TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
    </Grid>

    <TextBlock x:Name="FooterText" Grid.Row="3" Margin="2,10,2,0" FontSize="11"
               Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
  </Grid>
</Window>
